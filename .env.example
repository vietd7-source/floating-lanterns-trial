# TikTok Live connection
TIKTOK_USERNAME=
# Required — sign up for a free/paid key at https://www.eulerstream.com
# Without this, connections are likely to fail or hit the shared public quota fast.
EULERSTREAM_API_KEY=

# Server
PORT=3000

# Mock / test mode — only bind 127.0.0.1 when true, must be false on real live
ENABLE_MOCK=true

# Set true only when actually pushing to RTMP (ffmpeg stage, later steps)
ENABLE_RTMP=false
RTMP_URL=
STREAM_KEY=

# TTS
TTS_VOICE=vi-VN-HoaiMyNeural
